# ============================================================
#  Temozonia App — Environment Variables
#  Copy this file to .env.local and fill with real values.
#  NEVER commit .env.local to version control.
# ============================================================

# --- Next.js ---
NEXTAUTH_URL=https://temozonia-app.vercel.app
NEXTAUTH_SECRET=__generate_a_secure_random_secret__

# --- BTCPay Server ---
BTCPAY_SERVER_URL=https://your-btcpay-instance.com
BTCPAY_STORE_ID=your_store_id_here
BTCPAY_WEBHOOK_SECRET=__generate_a_secure_webhook_secret__
BTCPAY_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nYOUR_BTCPAY_PRIVATE_KEY\n-----END EC PRIVATE KEY-----

# --- Mercado Pago ---
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-mercadopago-token
MERCADO_PAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key
MERCADO_PAGO_WEBHOOK_SECRET=__mercadopago_webhook_secret__

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=EAA_your_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ADMIN_NUMBER=5215500000000

# --- Stripe (Fiat fallback) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --- Skydropx (Shipping) ---
SKYDROPX_API_KEY=your_skydropx_api_key

# --- App ---
APP_URL=https://temozonia-app.vercel.app
NEXT_PUBLIC_APP_URL=https://temozonia-app.vercel.app
NEXT_PUBLIC_WHATSAPP_ADMIN_NUMBER=5215500000000
NEXT_PUBLIC_DEFAULT_LOCALE=es
